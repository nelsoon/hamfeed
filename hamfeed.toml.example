# hamfeed.toml (example — copy to hamfeed.toml and adjust; real file is gitignored)

[audio]
device = "default"
sample_rate = 16000

[vad]
engine = "energy"
hang_ms = 800
# Cut segments on repeater courtesy beeps (Slice 2); beep_min_ms is the
# sustained-tone persistence before a beep cuts (50..=1000).
beep_split = true
beep_min_ms = 150
[vad.profiles.repeater]
hang_ms = 800
[vad.profiles.simplex]
hang_ms = 1200

[segment]
max_s = 120

[stt]
model_path = "models/whisper-small.bin"
lang_whitelist = ["fr", "en"]
# Optional whisper initial-prompt override. Omitted → built-in bilingual
# (FR/EN) repeater context: callsigns, NATO words, Q codes.
# initial_prompt = "VE2ABC net, nightly round table, over."

[storage]
dir = "./data/audio"
db_path = "./data/hamfeed.db"
retention_days = 90
delete_audio_on_drop = false

[station]
freq_label = "REPEATER-XXX.XXX"
