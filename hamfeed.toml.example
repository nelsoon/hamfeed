# hamfeed.toml (example — copy to hamfeed.toml and adjust; real file is gitignored)

[audio]
device = "default"
sample_rate = 16000

# Audio input: "mic" (cpal device above) or "sdr" (B210 capture shim).
[source]
kind = "mic"

# SDR station parameters, measured on 10.0.2.102 — do not re-tune
# blindly. Only used when [source] kind = "sdr". A channel is a named
# frequency; the mode alone selects the demod path (nbfm today).
# [sdr]
# python = "python3"
# script = "sdr/sdr_rx.py"
# gain = 20.0
# rate_hz = 250000.0
# bandwidth_hz = 200000.0
# squelch_db = 13.0
# hang_s = 1.5
# antenna = "RX2"
# active = "2m VE2"
# [[sdr.channels]]
# name = "2m VE2"
# freq_hz = 145110000.0
# [[sdr.channels]]
# name = "2m RQG"
# freq_hz = 146610000.0
# [[sdr.channels]]
# name = "marine"
# freq_hz = 161750000.0

[vad]
engine = "energy"
hang_ms = 800
# Cut segments on repeater courtesy beeps (Slice 2); beep_min_ms is the
# sustained-tone persistence before a beep cuts (50..=1000).
beep_split = true
beep_min_ms = 150
[vad.profiles.repeater]
hang_ms = 800
[vad.profiles.simplex]
hang_ms = 1200

[segment]
max_s = 120

[stt]
model_path = "models/whisper-small.bin"
lang_whitelist = ["fr", "en"]
# Optional whisper initial-prompt override. Omitted → built-in bilingual
# (FR/EN) repeater context: callsigns, NATO words, Q codes.
# initial_prompt = "VE2ABC net, nightly round table, over."
# Decoder thread cap. Omitted → all cores minus one (never 0): a
# saturated box starves capture + the live relay.
# threads = 3
# Low-confidence language fallback: when detection scores below
# lang_min_conf, decode in lang_fallback (must be whitelisted)
# instead of a guess. Omitted → pure detection.
# lang_min_conf = 0.85
# lang_fallback = "fr"

[storage]
dir = "./data/audio"
db_path = "./data/hamfeed.db"
retention_days = 90
delete_audio_on_drop = false

[station]
# Your own callsign: messages addressed to it raise a for-you notification.
# Spelled forms ("Victor Echo 2 ...") are derived automatically.
# my_callsign = "VE2XXX"

# Sender carry window (Slice 2): follow-ups within this many minutes of the
# last heard self-ID inherit its sender, marked inferred (1..=240).
[identity]
link_window_min = 30

# Local callbook (Slice 2): uncomment to override the derived path
# (<storage.dir>/callbook.db). Missing file degrades to nameless badges.
[callbook]
# db_path = "./data/audio/callbook.db"

# Emergency cue list (Slice 2): matched case-insensitively (FR+EN defaults).
[notify]
emergency_cues = ["mayday", "may-day", "urgence", "emergency", "sos", "détresse", "detresse"]

# Voiceprints (Slice 2): empty model_path disables voice (loud log, never
# fatal). min_embed_s gates short blips; threshold is the cosine gate
# (0.0..=1.0); suggest_min_conf gates past-window suggestions.
[voiceprint]
# Master switch (default false): voice embeddings are derived only when
# you opt in here AND point model_path at a readable model. A public
# broadcast is not consent to biometric enrollment — see README "Privacy".
enabled = false
model_path = ""
min_embed_s = 1.5
threshold = 0.55
suggest_min_conf = 0.5
retention_days = 7
